%posorden(arbol(A,nil,nil),[A]) :-!.
%posorden(arbol(A,X,nil),S) :- posorden(X,C),append(C,[A],S).
%posorden(arbol(A,nil,X),S) :- posorden(X,C),append(C,[A],S).
%posorden(arbol(A,X,Y),S) :- posorden(X,C),posorden(Y,F),append(C,F,D),
%			     append(D,[A],S).

posorden(Arbol,Posorden) :- posorden_dl(Arbol, Posorden-[]).
posorden_dl(arbol(A,nil,nil),[A|X]-X) :-!.
posorden_dl(arbol(A,I,nil),C-X) :- posorden_dl(I,C-[A|X]).
posorden_dl(arbol(A,nil,D),S) :- posorden_dl(D,C-[A|X]).
posorden_dl(arbol(A,I,D),C-F) :- posorden_dl(I,C-X),posorden_dl(D,X-[A|F]).
